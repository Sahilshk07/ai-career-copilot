# ===========================
# AI Career Copilot - Environment Variables
# ===========================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Google Gemini API Key (required)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Adzuna Job API Credentials (optional - enables live job listings)
# Register at: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Flask Secret Key (required for session management)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_flask_secret_key_here

# Server Port (optional - defaults to 5000 locally, auto-set on Cloud Run)
PORT=5000
